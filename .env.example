# Prefer npm run setup to generate fresh local credentials.
PORT=4100
HOST=127.0.0.1
JWT_SECRET=
ADMIN_EMAIL=admin@youthmed.mn
ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:5179,http://127.0.0.1:5181
# Optional absolute path to persistent storage; defaults to ./data
# DATA_DIR=/absolute/path/to/data
# Optional, only for seed-demo-content.js:
# DEMO_ASSET_DIR=/absolute/path/to/youth_med/assets
# Optional mounted persistent disk for uploaded images/videos:
# UPLOAD_DIR=/absolute/path/to/media
