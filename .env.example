# DATA_DIR=/absolute/path/to/data
# Optional, only for seed-demo-content.js:
# DEMO_ASSET_DIR=/absolute/path/to/youth_med/assets
# Optional mounted persistent disk for uploaded images/videos:
# UPLOAD_DIR=/absolute/path/to/media
